#!/usr/bin/env node
'use strict';

/**
 * validate.js — a deterministic static validator for a Keen flow project.
 *
 *   node validate.js <project-dir>
 *
 * Checks a project's `.flow` files, scripts, and keen-tools.json against the documented
 * contracts (node-spec.js) BEFORE deploy — catching the silent failures that otherwise
 * only surface at runtime as "No tool response", a stalled flow, or a rejected deploy.
 *
 * Exit code: 0 = no errors (warnings allowed), 1 = at least one error, 2 = usage/IO error.
 */

const fs = require('fs');
const path = require('path');
const {
    SPEC, WAIT_ONLY_FROM, ENGINE_OUT_KEYS, RULES, normalizeHandle, typeFromId
} = require('./node-spec');
const { lintScript } = require('./script-lint');

// ─── finding accumulator ────────────────────────────────────────────────────
const findings = [];
function err(file, where, msg) { findings.push({ level: 'error', file, where, msg }); }
function warn(file, where, msg) { findings.push({ level: 'warn', file, where, msg }); }
function info(file, where, msg) { findings.push({ level: 'info', file, where, msg }); }

// ─── project loading ─────────────────────────────────────────────────────────
function loadProject(root) {
    const src = path.join(root, 'src');
    const flowsDir = path.join(src, 'flows');
    const scriptsDir = path.join(src, 'scripts');
    const toolsPath = path.join(src, 'keen-tools.json');

    if (!fs.existsSync(flowsDir)) { err('project', 'src/flows', 'missing src/flows directory'); }
    if (!fs.existsSync(scriptsDir)) { err('project', 'src/scripts', 'missing src/scripts directory'); }

    const flowFiles = fs.existsSync(flowsDir)
        ? fs.readdirSync(flowsDir).filter(f => f.endsWith('.flow'))
        : [];

    const scripts = new Set();
    if (fs.existsSync(scriptsDir)) {
        const walk = d => fs.readdirSync(d, { withFileTypes: true }).forEach(e => {
            const p = path.join(d, e.name);
            if (e.isDirectory()) walk(p);
            else if (e.name.endsWith('.js')) scripts.add(path.relative(scriptsDir, p).split(path.sep).join('/'));
        });
        walk(scriptsDir);
    }

    let tools = null;
    if (fs.existsSync(toolsPath)) {
        try { tools = JSON.parse(fs.readFileSync(toolsPath, 'utf8')); }
        catch (e) { err('keen-tools.json', '', `invalid JSON: ${e.message}`); }
    } else {
        warn('keen-tools.json', '', 'missing src/keen-tools.json (fine if the project declares no tools)');
    }

    return { root, flowsDir, scriptsDir, flowFiles, scripts, tools };
}

// ─── flow parsing ──────────────────────────────────────────────────────────
function parseFlow(flowsDir, file) {
    const raw = fs.readFileSync(path.join(flowsDir, file), 'utf8');
    let doc;
    try { doc = JSON.parse(raw); }
    catch (e) { err(file, '', `invalid JSON: ${e.message}`); return null; }

    if (!doc || typeof doc !== 'object' || Array.isArray(doc)) { err(file, '', 'top level must be an object { nodes, edges }'); return null; }
    if (!Array.isArray(doc.nodes)) { err(file, '', '`nodes` must be an array'); doc.nodes = []; }
    if (!Array.isArray(doc.edges)) { warn(file, '', '`edges` missing or not an array — treating as []'); doc.edges = []; }
    for (const k of Object.keys(doc)) {
        if (k !== 'nodes' && k !== 'edges') warn(file, '', `unexpected top-level key "${k}" — the canvas keeps only { nodes, edges } and drops the rest`);
    }
    return doc;
}

// ─── per-node checks ─────────────────────────────────────────────────────────
function checkNode(file, node) {
    if (!node || typeof node !== 'object') { err(file, '(node)', 'node is not an object'); return; }
    const id = node.id;
    if (typeof id !== 'string' || !id) { err(file, '(node)', 'node has no string id'); return; }

    const typeFromPrefix = typeFromId(id);
    if (!typeFromPrefix) err(file, id, `id prefix does not match any node type (expected "<type>_<12 chars>")`);
    if (!node.type) err(file, id, 'node.type is missing');
    else if (!SPEC[node.type]) err(file, id, `unknown node.type "${node.type}"`);
    else if (typeFromPrefix && typeFromPrefix !== node.type) err(file, id, `node.type "${node.type}" disagrees with id prefix "${typeFromPrefix}_"`);

    const type = node.type && SPEC[node.type] ? node.type : typeFromPrefix;
    const spec = type && SPEC[type];
    if (!spec) return;

    // id format
    const idBody = id.slice(type.length + 1);
    if (!/^[A-Za-z0-9]{12}$/.test(idBody)) warn(file, id, `id body "${idBody}" is not 12 A–Za–z0–9 chars (canvas generates 12)`);

    // dragHandle
    if (node.dragHandle !== '.drag-handle__custom') warn(file, id, `dragHandle should be ".drag-handle__custom" (got ${JSON.stringify(node.dragHandle)})`);

    const data = node.data || {};
    // fixed labels
    if (data.labelNode !== spec.labelNode) err(file, id, `data.labelNode must be "${spec.labelNode}" (got ${JSON.stringify(data.labelNode)})`);
    if (data.descriptionNode !== spec.descriptionNode) err(file, id, `data.descriptionNode must be "${spec.descriptionNode}" (got ${JSON.stringify(data.descriptionNode)})`);

    // position
    if (!node.position || typeof node.position.x !== 'number' || typeof node.position.y !== 'number') warn(file, id, 'position {x,y} missing or non-numeric');

    checkNodeFields(file, id, type, data.settings || {}, data);
}

function checkNodeFields(file, id, type, s, data) {
    const R = RULES;
    switch (type) {
        case 'startNode': {
            const label = s.value ?? s.label ?? data.label;
            if (!label) err(file, id, 'Start node has no Label (settings.value) — it is the flow entry name');
            else if (!R.startLabel.test(label)) err(file, id, `Start label "${label}" must match ${R.startLabel} (one capitalized word, letters only)`);
            else if (label.length > R.startLabelMax) err(file, id, `Start label exceeds ${R.startLabelMax} chars`);
            break;
        }
        case 'conditionNode': {
            const expr = s.value;
            if (!expr || typeof expr !== 'string') err(file, id, 'Condition has no expression (settings.value)');
            else {
                if (/(^|[^${\w.])(dictionary|session)\.\w/.test(expr) && !/\$\{(dictionary|session)\./.test(expr))
                    err(file, id, `Condition uses a BARE "dictionary."/"session." — the engine throws "Member access is not allowed". Wrap it: \${dictionary.x} === true`);
                checkPlaceholders(file, id, expr);
            }
            break;
        }
        case 'loopNode': {
            for (const f of ['value', 'setto']) {
                const v = s[f];
                if (!v) err(file, id, `Loop "${f === 'value' ? 'Read from' : 'Set to'}" is empty`);
                else if (!R.dictOrSessionRef.test(v)) err(file, id, `Loop "${f}" = ${JSON.stringify(v)} must be "dictionary.<path>" or "session.<key>" (bare name throws "invalid ${f}")`);
            }
            if (s.value && s.setto && s.value === s.setto) err(file, id, 'Loop Read from and Set to must differ');
            break;
        }
        case 'assignmentNode':
        case 'scriptNode': {
            const pairs = s.keyValuePairs;
            if (pairs !== undefined) {
                if (!Array.isArray(pairs)) err(file, id, 'settings.keyValuePairs must be an array');
                else {
                    if (pairs.length > R.kvMaxPairs) err(file, id, `too many key/value pairs (${pairs.length} > ${R.kvMaxPairs})`);
                    const seen = new Set();
                    for (const p of pairs) {
                        if (!p || typeof p.key !== 'string') { err(file, id, 'a key/value pair has no string key'); continue; }
                        if (p.key.length > R.kvKeyMax) err(file, id, `pair key "${p.key}" exceeds ${R.kvKeyMax} chars`);
                        if (typeof p.value === 'string' && p.value.length > R.kvValueMax) err(file, id, `pair "${p.key}" value exceeds ${R.kvValueMax} chars`);
                        if (seen.has(p.key)) err(file, id, `duplicate key "${p.key}" in key/value pairs`);
                        seen.add(p.key);
                        if (typeof p.value === 'string') checkPlaceholders(file, id, p.value);
                    }
                }
            }
            if (type === 'scriptNode') {
                const sp = s.value;
                if (!sp) err(file, id, 'Script node has no Script path (settings.value)');
                else {
                    if (!sp.endsWith('.js')) err(file, id, `Script path "${sp}" must end with .js`);
                    if (sp.length > R.scriptPathMax) err(file, id, `Script path exceeds ${R.scriptPathMax} chars`);
                }
            }
            break;
        }
        case 'runFlowNode':
        case 'jumpFlowNode':
        case 'parallelFlowNode': {
            const v = s.value;
            if (!v) err(file, id, `${type} has no Flow target (settings.value)`);
            else if (!RULES.fileLabel.test(v)) err(file, id, `Flow target "${v}" must be a File-Label (${RULES.fileLabel}) — the canvas form rejects digits and \${…}`);
            break;
        }
        case 'parallelContextNode': {
            if (!s.contextCollection) err(file, id, 'Parallel Context has no Context Collection');
            else if (!RULES.dictRef.test(s.contextCollection)) err(file, id, `contextCollection ${JSON.stringify(s.contextCollection)} must start with "dictionary."`);
            if (!s.pipe) err(file, id, 'Parallel Context has no Flow Pointer (settings.pipe)');
            else if (!RULES.fileLabel.test(s.pipe)) err(file, id, `pipe "${s.pipe}" must be a File-Label (${RULES.fileLabel})`);
            if (!s.assignTo) warn(file, id, 'Parallel Context "Assign result" is empty — the form requires it (though the engine ignores it; read results from the collection)');
            break;
        }
        case 'agentNode': {
            const aid = s.agentId;
            if (!aid) err(file, id, 'Agent (LLM) node has no agentId');
            else if (!RULES.agentId.test(aid)) err(file, id, `agentId "${aid}" must be kebab-case letters-only (${RULES.agentId})`);
            const name = s.agentName;
            if (!name) err(file, id, 'Agent (LLM) node has no agentName');
            else if (name.length < RULES.agentNameMin || name.length > RULES.agentNameMax) warn(file, id, `agentName length should be ${RULES.agentNameMin}–${RULES.agentNameMax}`);
            if (!s.llm || typeof s.llm !== 'object') err(file, id, 'Agent (LLM) node has no settings.llm block (company/model/parameters)');
            else {
                if (!s.llm.company) warn(file, id, 'settings.llm.company missing');
                if (!s.llm.model) warn(file, id, 'settings.llm.model missing');
            }
            for (const p of (Array.isArray(s.prompts) ? s.prompts : [])) {
                if (typeof p.content === 'string') checkPlaceholders(file, id, p.content);
            }
            break;
        }
        case 'noteNode': {
            const label = data.label ?? s.value;
            if (label && label.length > RULES.noteMax) warn(file, id, `Note text exceeds ${RULES.noteMax} chars`);
            break;
        }
        default: break;
    }
}

function checkPlaceholders(file, id, text) {
    // flag placeholder roots other than dictionary/session
    const m = String(text).match(/\$\{([a-zA-Z_]+)\./g) || [];
    for (const raw of m) {
        const root = raw.slice(2, -1);
        if (root !== 'dictionary' && root !== 'session')
            warn(file, id, `placeholder \${${root}.…} — only \${dictionary.*} and \${session.*} resolve; "${root}" will be empty`);
    }
}

// ─── per-edge + wiring checks ────────────────────────────────────────────────
function checkEdgesAndWiring(file, doc) {
    const nodes = doc.nodes;
    const byId = new Map(nodes.map(n => [n && n.id, n]));
    const typeOf = n => (n && n.type && SPEC[n.type]) ? n.type : typeFromId(n && n.id);

    // outgoing[node.id][handle] = [targets], incoming[node.id][handle] = [sources]
    const outByHandle = new Map();
    const inCount = new Map();      // target node id + handle → count
    const inFromTypes = new Map();  // target node id + handle → [source types]

    for (const e of doc.edges) {
        if (!e || typeof e !== 'object') { err(file, '(edge)', 'edge is not an object'); continue; }
        const { source, target, sourceHandle, targetHandle } = e;
        if (!byId.has(source)) err(file, '(edge)', `edge.source "${source}" is not a node in this flow`);
        if (!byId.has(target)) err(file, '(edge)', `edge.target "${target}" is not a node in this flow`);
        if (e.type && e.type !== 'step') warn(file, '(edge)', `edge.type "${e.type}" — the canvas writes "step"`);

        const sNode = byId.get(source), tNode = byId.get(target);
        const sType = sNode && typeOf(sNode), tType = tNode && typeOf(tNode);

        if (sType && SPEC[sType]) {
            if (!sourceHandle) err(file, source, 'edge has no sourceHandle');
            else if (!SPEC[sType].sources.includes(sourceHandle))
                err(file, source, `sourceHandle "${sourceHandle}" is not valid on ${sType} (valid: ${SPEC[sType].sources.join(', ') || 'none'})`);
            else {
                const key = source;
                if (!outByHandle.has(key)) outByHandle.set(key, {});
                (outByHandle.get(key)[sourceHandle] ||= []).push(target);
            }
        }
        if (tType && SPEC[tType]) {
            if (!targetHandle) err(file, target, 'edge has no targetHandle');
            else if (!SPEC[tType].targets.includes(targetHandle))
                err(file, target, `targetHandle "${targetHandle}" is not valid on ${tType} (valid: ${SPEC[tType].targets.join(', ') || 'none'})`);
            else {
                const k = `${target}::${targetHandle}`;
                inCount.set(k, (inCount.get(k) || 0) + 1);
                (inFromTypes.get(k) || inFromTypes.set(k, []).get(k)).push(sType);
                // multi-in check
                if (inCount.get(k) > 1 && !SPEC[tType].multiIn.includes(targetHandle))
                    err(file, target, `handle "${targetHandle}" on ${tType} is single-in but has ${inCount.get(k)} incoming edges`);
                // wait onlyFrom
                if (targetHandle === 'wait' && sType && !WAIT_ONLY_FROM.includes(sType))
                    err(file, target, `wait handle accepts only ${WAIT_ONLY_FROM.join('/')} sources (got ${sType})`);
            }
        }
    }

    // required / recommended out-handles
    for (const n of nodes) {
        if (!n || !n.id) continue;
        const t = typeOf(n);
        const spec = t && SPEC[t];
        if (!spec) continue;
        const outs = outByHandle.get(n.id) || {};
        for (const h of spec.requiredOut) {
            if (!outs[h] || outs[h].length === 0) warn(file, n.id, `${t} out-handle "${h}" is not wired — that path dead-ends`);
        }
        for (const h of spec.recommendOut) {
            if (!outs[h] || outs[h].length === 0) warn(file, n.id, `${t} "${h}" edge is not wired — a failure here has no handler (wire it for robustness)`);
        }
    }

    // reachability from any start node
    const starts = nodes.filter(n => typeOf(n) === 'startNode').map(n => n.id);
    const reach = new Set(starts);
    let grew = true;
    while (grew) {
        grew = false;
        for (const [src, handles] of outByHandle) {
            if (!reach.has(src)) continue;
            for (const targets of Object.values(handles)) for (const tgt of targets) if (!reach.has(tgt)) { reach.add(tgt); grew = true; }
        }
    }
    for (const n of nodes) {
        const t = typeOf(n);
        if (!n || !n.id || t === 'startNode' || t === 'noteNode' || t === 'parallelFlowNode') continue;
        if (!reach.has(n.id)) warn(file, n.id, `${t} is not reachable from any Start node`);
    }

    return { outByHandle };
}

// ─── cross-file + tool registry ──────────────────────────────────────────────
function buildEntryRegistry(project, parsed) {
    // File-Label → { file } for every start node label
    const registry = new Map();
    for (const { file, doc } of parsed) {
        const base = file.replace(/\.flow$/, '');
        if (!RULES.flowFileName.test(base)) err(file, '', `flow file name "${base}" must be PascalCase (${RULES.flowFileName})`);
        for (const n of doc.nodes) {
            if ((n.type === 'startNode' || typeFromId(n.id) === 'startNode')) {
                const label = (n.data && n.data.settings && (n.data.settings.value || n.data.settings.label)) || (n.data && n.data.label);
                if (label && RULES.startLabel.test(label)) registry.set(`${base}-${label}`, file);
            }
        }
    }
    return registry;
}

function checkCrossFile(project, parsed, registry) {
    for (const { file, doc } of parsed) {
        for (const n of doc.nodes) {
            const t = (n.type && SPEC[n.type]) ? n.type : typeFromId(n.id);
            const s = (n.data && n.data.settings) || {};
            const target =
                (t === 'runFlowNode' || t === 'jumpFlowNode' || t === 'parallelFlowNode') ? s.value :
                (t === 'parallelContextNode') ? s.pipe : null;
            if (target && RULES.fileLabel.test(target) && !registry.has(target))
                err(file, n.id, `${t} target "${target}" does not resolve to any flow's Start (File-Label). Known entries: ${[...registry.keys()].join(', ') || '(none)'}`);
            // scriptNode file existence
            if (t === 'scriptNode' && s.value) {
                if (!project.scripts.has(s.value)) err(file, n.id, `Script file "${s.value}" not found under src/scripts/`);
            }
        }
    }
}

function checkTools(project, registry) {
    const tools = project.tools;
    if (!tools) return;
    if (!Array.isArray(tools.tools)) { err('keen-tools.json', '', 'expected { "tools": [ … ] }'); return; }
    const names = new Set();
    for (const tool of tools.tools) {
        const label = tool && tool.name ? tool.name : '(unnamed)';
        if (!tool || typeof tool.name !== 'string') { err('keen-tools.json', label, 'tool has no string name'); continue; }
        if (names.has(tool.name)) err('keen-tools.json', label, `duplicate tool name "${tool.name}"`);
        names.add(tool.name);
        if (tool.type !== 'script' && tool.type !== 'flow') { err('keen-tools.json', label, `tool.type must be "script" or "flow" (got ${JSON.stringify(tool.type)})`); continue; }
        if (typeof tool.entry !== 'string' || !tool.entry) { err('keen-tools.json', label, 'tool.entry is missing'); continue; }
        if (tool.type === 'script') {
            if (!tool.entry.startsWith('tools/')) err('keen-tools.json', label, `script tool entry "${tool.entry}" must start with "tools/"`);
            else if (tool.entry.includes('..')) err('keen-tools.json', label, `script tool entry "${tool.entry}" must not contain ".."`);
            else if (!project.scripts.has(tool.entry)) err('keen-tools.json', label, `script tool entry "${tool.entry}" not found under src/scripts/`);
        } else { // flow
            if (!RULES.fileLabel.test(tool.entry)) err('keen-tools.json', label, `flow tool entry "${tool.entry}" must be a File-Label (${RULES.fileLabel})`);
            else if (!registry.has(tool.entry)) err('keen-tools.json', label, `flow tool entry "${tool.entry}" does not resolve to any flow's Start`);
        }
    }
}

// ─── main ────────────────────────────────────────────────────────────────────
function main() {
    const root = process.argv[2];
    if (!root) { console.error('usage: node validate.js <project-dir>'); process.exit(2); }
    if (!fs.existsSync(root)) { console.error(`no such directory: ${root}`); process.exit(2); }

    const project = loadProject(root);
    const parsed = [];
    for (const file of project.flowFiles) {
        const doc = parseFlow(project.flowsDir, file);
        if (!doc) continue;
        parsed.push({ file, doc });
        for (const n of doc.nodes) checkNode(file, n);
        checkEdgesAndWiring(file, doc);
    }
    const registry = buildEntryRegistry(project, parsed);
    checkCrossFile(project, parsed, registry);
    checkTools(project, registry);

    // ── script-contract lint ─────────────────────────────────────────────────
    // A script is a "tool" if a keen-tools.json script tool points at it.
    const toolScripts = new Set(
        (project.tools && Array.isArray(project.tools.tools) ? project.tools.tools : [])
            .filter(t => t && t.type === 'script' && typeof t.entry === 'string')
            .map(t => t.entry)
    );
    for (const rel of project.scripts) {
        let source;
        try { source = fs.readFileSync(path.join(project.scriptsDir, rel), 'utf8'); }
        catch (e) { err(`scripts/${rel}`, '', `cannot read: ${e.message}`); continue; }
        const isTool = toolScripts.has(rel);
        lintScript(source, (level, msg) => findings.push({ level, file: `scripts/${rel}${isTool ? ' (tool)' : ''}`, where: '', msg }), { isTool });
    }

    // report
    const errs = findings.filter(f => f.level === 'error');
    const warns = findings.filter(f => f.level === 'warn');
    const infos = findings.filter(f => f.level === 'info');
    const order = { error: 0, warn: 1, info: 2 };
    findings.sort((a, b) => order[a.level] - order[b.level] || a.file.localeCompare(b.file));

    const tag = { error: '✗ ERROR', warn: '⚠ WARN ', info: 'ℹ INFO ' };
    for (const f of findings) console.log(`${tag[f.level]}  ${f.file}${f.where ? ' › ' + f.where : ''}\n           ${f.msg}`);

    console.log('\n──────────────────────────────────────────');
    console.log(`entries (File-Labels) found: ${[...registry.keys()].join(', ') || '(none)'}`);
    console.log(`flows: ${project.flowFiles.length} · scripts: ${project.scripts.size} · tools: ${project.tools && Array.isArray(project.tools.tools) ? project.tools.tools.length : 0}`);
    console.log(`${errs.length} error(s), ${warns.length} warning(s), ${infos.length} info`);
    process.exit(errs.length > 0 ? 1 : 0);
}

main();
