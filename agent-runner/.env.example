# agent-runner — one .env, nine core values (plus a few optional ones at the
# bottom). Fill them once; run.ts, deploy.ts, keen-deploy (Go) and keen-validate
# all read this file. A --flag overrides the matching value. Write values
# UNQUOTED (KEY=value): the Go tools keep surrounding quotes literally, while
# run.ts (dotenv) strips them. This binds the runner to ONE space (to deploy
# into) and ONE agent (to chat with) — nothing else is needed.
#
#   cp .env.example .env    # then edit

# ── The Keen host — ONE value; every URL derives from it ────────────────────
#     WS      wss://<host>/ws-keen        (run.ts — also for a local stack: KEEN_HOST=localhost)
#     deploy  https://<host>/ms/deploy    (deploy.ts / keen-deploy)
# A bare host — no scheme, no path. For a self-signed dev cert also export
# NODE_TLS_REJECT_UNAUTHORIZED=0.
KEEN_HOST=ksbx-003.keenbot.ai

# ── Identity — the consumer that runs the flow and owns the chat ────────────
# A consumer access_token. Its sub is sealed in the token, so set KEEN_USER_ID too.
# Headless way (preferred for an agent): the Keen MCP server. An MCP account
# creates an MCP consumer (id + secret, no email/password, never an OTP) and
# calls get_mcp_consumer_token (id + secret) -> access_token = KEEN_TOKEN and
# the consumer's id = KEEN_USER_ID. See ../keen-mcp-guide/README.md.
# Alternative (a human consumer): copy the access_token from the consumer app's
# browser cookies (DevTools -> Application -> Cookies) and the consumer's id.
KEEN_TOKEN=
# The consumer's id — the relay enforces userId === the token's (sealed) sub.
# (For an MCP consumer: the id returned alongside the token.)
KEEN_USER_ID=
# The identity's email (presence-checked — any non-empty value). An MCP consumer
# has no email, so any non-empty value is fine here.
KEEN_EMAIL=agent@runner.local
# This runner's origin — MUST be allow-listed on the api_key, or the relay
# silently drops the socket. scheme://host[:port], exact match.
KEEN_ORIGIN=https://your-allow-listed-origin.example

# ── The one space + the one agent ───────────────────────────────────────────
# The AI space id — the deploy target AND the space the agent lives in.
KEEN_SPACE_ID=
# The agent SLUG (agentId) — not the row id.
KEEN_AGENT=

# ── Deploy ──────────────────────────────────────────────────────────────────
# The space's deployment token (Admin console → the space → deployment token).
KEEN_DEPLOY_TOKEN=
# The flow project ROOT (the folder that contains src/). deploy zips <root>/src
# so flows/ + scripts/ go live; keen-validate reads the same root. One value,
# both tools.
KEEN_PROJECT_DIR=./my-flow-project

# ── Optional ────────────────────────────────────────────────────────────────
# Pin ONE chat id so every run continues the same conversation (run.ts mints a
# fresh one — a new chat thread — when unset, and prints a hint with the id).
#KEEN_CHAT_ID=
# Cookies the flow's script nodes should see (system/cookies): a=1;b=2
# (--cookie name=value on the command line adds to / overrides these).
#KEEN_COOKIES=
# keen-deploy only: skip TLS verification for a self-signed dev cert (true or 1).
# run.ts has no such switch — prefix it with NODE_TLS_REJECT_UNAUTHORIZED=0.
#KEEN_TLS_INSECURE=
# run.ts fallback for --prompt (a prompt is per-run; normally leave unset).
#KEEN_PROMPT=
